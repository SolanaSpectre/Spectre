# ==========================================
# SOLANA MEMECOIN TRADING BOT CONFIGURATION
# ==========================================

# ==========================================
# SOLANA RPC CONFIGURATION
# ==========================================
# Primary RPC URL. For backend bots, prefer Gatekeeper or a standard provider API-key URL.
SOLANA_RPC_URL=

# Optional primary websocket URL for the Solana RPC above.
SOLANA_RPC_WEBSOCKET_URL=

# Fallback RPC URL. Prefer a second provider when available; same-vendor fallback is weak redundancy.
SOLANA_RPC_FALLBACK=

# Optional websocket URL for the fallback RPC above.
SOLANA_RPC_FALLBACK_WEBSOCKET_URL=

# Circuit breaker tuning. Primary only degrades after the failure threshold is reached.
SOLANA_RPC_PRIMARY_DOWNGRADE_MS=60000
SOLANA_RPC_FALLBACK_DOWNGRADE_MS=60000
SOLANA_RPC_PRIMARY_FAILURE_THRESHOLD=2
SOLANA_RPC_FALLBACK_FAILURE_THRESHOLD=2
SOLANA_RPC_SAME_VENDOR_FALLBACK_ENABLED=false

# Shared JSON-RPC pacing. Keep conservative for paper runs on public or flaky local RPC paths.
SOLANA_RPC_MAX_CONCURRENT_REQUESTS=2
SOLANA_RPC_MIN_REQUEST_INTERVAL_MS=150
SOLANA_RPC_CALL_TIMEOUT_MS=10000

# Helius two-arm Pump.fun probe inputs. Enhanced carries transactionSubscribe;
# Standard carries lightweight logsSubscribe. Keep credential-bearing URLs only
# in .env. If both capabilities share one endpoint, the same URL may be used.
HELIUS_ENHANCED_WEBSOCKET_URL=
HELIUS_STANDARD_WEBSOCKET_URL=

# Report-only Pump.fun logs adapter. It cannot feed runtime strategy decisions.
# Enable only for a pre-registered parity run against PumpPortal/RPC truth.
HELIUS_PUMPFUN_SHADOW_ENABLED=false
HELIUS_PUMPFUN_SHADOW_COMMITMENT=processed
HELIUS_PUMPFUN_SHADOW_PING_INTERVAL_MS=25000
HELIUS_PUMPFUN_SHADOW_RECONNECT_DELAY_MS=1000
HELIUS_PUMPFUN_SHADOW_MAX_RECONNECT_DELAY_MS=30000
# Yield between bounded Helius decode batches so provider bursts cannot monopolize the event loop.
HELIUS_PUMPFUN_SHADOW_EVENT_QUEUE_MAX_SIZE=20000
HELIUS_PUMPFUN_SHADOW_EVENT_QUEUE_BATCH_SIZE=64
# Report-only dual computation. Effective only while the Helius shadow adapter is enabled.
HELIUS_PUMPFUN_DECISION_SHADOW_ENABLED=true

# Helius Parse API Key for enhanced transaction parsing/enrichment.
HELIUS_PARSE_API_KEY=

# ==========================================
# WALLET CONFIGURATION
# ==========================================
# Hot Wallet Private Key for active trading.
HOT_WALLET_PRIVATE_KEY=

# Cold Wallet Address for profit storage.
COLD_WALLET_ADDRESS=

# Cold Wallet Private Key is optional. Leave blank unless intentionally used later.
COLD_WALLET_PRIVATE_KEY=

# ==========================================
# EXECUTION / SESSION CONFIGURATION
# ==========================================
# Execution mode: DRY_RUN, PAPER, or LIVE.
EXECUTION_MODE=PAPER

# Paper/session runtime in minutes. CLI flags can override this.
SESSION_DURATION_MINUTES=15

# Virtual starting balance for PAPER mode.
PAPER_STARTING_BALANCE_SOL=5

# Generated-artifact archive root used by lifecycle cleanup.
SPECTRE_ARCHIVE_ROOT=E:\\Spectre-archives\\Spectre-clean

# Require LIVE mode to be explicitly confirmed via CLI.
MAX_QUOTE_AGE_MS=3000
TOKEN_SIGNAL_COOLDOWN_MS=120000
REJECTION_QUARANTINE_MS=60000
QUOTE_FAILURE_QUARANTINE_MS=600000
ENTRY_WARMUP_MS=90000
MAX_PUMP_TOKEN_AGE_SECONDS=300
PUMP_MOMENTUM_WINDOW_MS=120000
MIN_PUMP_RECENT_TRADES=6
MIN_PUMP_BUY_RATIO=0.62
MAX_PUMP_SELL_RATIO=0.32
MIN_PUMP_RECENT_VOLUME_SOL=1.5
MIN_PUMP_TRADE_VELOCITY_PER_MIN=4
MIN_PUMP_MOMENTUM_SCORE=0.68
PUMP_MOMENTUM_WEIGHT=0.35
BAD_EXIT_COOLDOWN_MS=600000
WEAK_EXIT_COOLDOWN_MS=300000
PAPER_STOP_LOSS_PERCENT=0.012
PAPER_TAKE_PROFIT_PERCENT=0.025
PAPER_TRAILING_ACTIVATION_PERCENT=0.020
PAPER_TRAILING_DRAWDOWN_PERCENT=0.008
PAPER_TRAILING_DISTANCE_PERCENT=0.008
PAPER_MIN_HOLD_SECONDS_FOR_PROFIT=45
PAPER_RUNNER_MODE_ENABLED=true
PAPER_RUNNER_REQUIRE_PUMP_MIGRATION=true
RUNNER_RAYDIUM_SHADOW_ENABLED=true
PAPER_RUNNER_MIN_MIGRATED_LIQUIDITY_USD=0
PAPER_MAX_HOLD_MINUTES=8
PAPER_CLOSE_ON_SESSION_END=true
MAX_OPEN_PAPER_POSITIONS=5
MAX_OPEN_LIVE_POSITIONS=1
# PAPER mode only: cache hot/cold balance reads for status accounting.
PAPER_BALANCE_REFRESH_INTERVAL_MS=60000
LIVE_EXIT_ENGINE_ENABLED=false

# ==========================================
# PROVIDER / MARKET DATA CONFIGURATION
# ==========================================
# Disable inherited Windows proxy env vars for API clients.
DISABLE_ENV_PROXY=true

# Jupiter quote/order/execute API.
JUPITER_API_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Raydium v3 pool API.
RAYDIUM_API_BASE_URL=https://api-v3.raydium.io
# Cache global pool list snapshots to avoid hammering Raydium during provider trouble.
RAYDIUM_POOL_CACHE_TTL_MS=60000
RAYDIUM_POOL_STALE_TTL_MS=300000

# Meteora DLMM pool API.
METEORA_ENABLED=true
METEORA_API_BASE_URL=https://dlmm.datapi.meteora.ag
# Cache global pool list snapshots to avoid hammering Meteora during provider trouble.
METEORA_POOL_CACHE_TTL_MS=60000
METEORA_POOL_STALE_TTL_MS=300000

# Birdeye enrichment. Keep enabled; it only activates when a key is present.
BIRDEYE_ENABLED=true
BIRDEYE_API_KEY=
BIRDEYE_API_BASE_URL=https://public-api.birdeye.so
# Standard Birdeye package is capped at 60 rpm total; keep the bot under that.
BIRDEYE_RATE_LIMIT_RPM=60
BIRDEYE_TARGET_RPM=45
BIRDEYE_CACHE_TTL_MS=60000
BIRDEYE_ERROR_CACHE_TTL_MS=15000
BIRDEYE_MAX_TOKENS_PER_CYCLE=1
BIRDEYE_RETRY_BASE_DELAY_MS=1000
BIRDEYE_MAX_RETRIES=3
BIRDEYE_SECURITY_ENABLED=false
BIRDEYE_HOLDER_DISTRIBUTION_ENABLED=false

# PumpPortal websocket/data API.
PUMPPORTAL_ENABLED=true
PUMP_PORTAL_API_KEY=
PUMPPORTAL_USE_API_KEY_QUERY=true
PUMPPORTAL_WEBSOCKET_URL=wss://pumpportal.fun/api/data
# Public address only. When set, lifecycle startup verifies that the linked API
# wallet can cover the provider floor plus the configured paid-event budget.
PUMPPORTAL_FUNDED_WALLET_ADDRESS=
# false permits the public address to be omitted. Once an address is configured,
# an invalid address, RPC failure, unbounded budget, or low balance blocks startup.
PUMPPORTAL_FUNDING_PREFLIGHT_REQUIRED=false
PUMPPORTAL_PROVIDER_MIN_FUNDED_BALANCE_SOL=0.02
PUMPPORTAL_FUNDING_PREFLIGHT_BUFFER_SOL=0.005
PUMPPORTAL_TRACKED_ACCOUNTS=
PUMPPORTAL_RECONNECT_DELAY_MS=5000
PUMPPORTAL_MAX_RECONNECT_DELAY_MS=10000
PUMPPORTAL_STALE_CONNECTION_MS=90000
PUMPPORTAL_HEALTH_CHECK_INTERVAL_MS=15000
PUMPPORTAL_PING_INTERVAL_MS=25000
PUMPPORTAL_MAX_SUBSCRIBED_MINTS=750
PUMPPORTAL_TOKEN_TRADE_SUBSCRIPTION_TTL_MS=1800000
# PumpPortal meters token/account trades at 0.01 SOL per 10,000 events.
# DANGER: 0 means UNLIMITED paid events, not zero spend. Use only intentionally.
# Helius decision-shadow V4 pre-registers a 72,000-event (up to about 0.07 SOL) PAPER60 budget.
# With the 0.02 SOL provider floor and 0.005 SOL buffer, preflight requires 0.095 SOL.
PUMPPORTAL_MAX_METERED_TRADE_EVENTS_PER_SESSION=72000
# targeted_curve waits for free discovery + RPC curve truth before enabling paid token tape.
# Set all_discovered explicitly to restore broad paid subscriptions.
PUMPPORTAL_TRADE_SUBSCRIPTION_MODE=targeted_curve
PUMPPORTAL_TARGETED_MIN_CURVE_PROGRESS=0.25
PUMPPORTAL_TARGETED_MAX_CURVE_PROGRESS=0.90
# Below-band mints receive bounded RPC rechecks for 3 minutes at the bonding-curve refresh cadence.
PUMPPORTAL_TARGETED_PREFILTER_MAX_AGE_MS=180000
PUMPPORTAL_EVENT_HANDLER_CONCURRENCY=6
PUMPPORTAL_EVENT_QUEUE_MAX_SIZE=10000

# Pump bonding curve RPC enrichment. Failure cooldown prevents repeated getAccountInfo
# retries for the same mint; global backoff pauses fresh lookups during RPC trouble.
PUMP_BONDING_CURVE_LANE_ENABLED=true
PUMP_BONDING_CURVE_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMP_BONDING_CURVE_REFRESH_INTERVAL_MS=15000
PUMP_BONDING_CURVE_MAX_TRACKED_MINTS=5000
PUMP_BONDING_CURVE_FAILURE_COOLDOWN_MS=120000
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_MS=30000
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_ERROR_THRESHOLD=5
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_WINDOW_MS=15000
# During global RPC backoff, already-observed high-curve mints can still refresh
# so near-migration candidates do not go stale behind low-curve lookup noise.
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_HIGH_CURVE_BYPASS_PROGRESS=0.85
PUMP_BONDING_CURVE_MAX_FETCHES_PER_CYCLE=12
PUMP_BONDING_CURVE_RUNTIME_RPC_ENABLED=true
# Safety rail: leave false/blank. Only set true after a separate live final-verification
# design exists if runtime curve RPC is intentionally disabled.
LIVE_ALLOW_DISABLED_BONDING_CURVE_RPC=false
PUMP_BONDING_CURVE_BATCH_FETCH_ENABLED=true
PUMP_BONDING_CURVE_BATCH_FLUSH_MS=150
PUMP_BONDING_CURVE_BATCH_MAX_ACCOUNTS=25
PUMP_BONDING_CURVE_RPC_COMMITMENT=processed

# Report-only finalist stream verifier. During the PAPER Helius V5 experiment it
# prewarms likely decision mints, then promotes/refreshes only when the paper lane
# emits a comparison event. It never affects entries or exits.
FINALIST_ACCOUNT_VERIFIER_ENABLED=true
FINALIST_ACCOUNT_VERIFIER_COMMITMENT=processed
FINALIST_ACCOUNT_VERIFIER_MAX_SUBSCRIPTIONS=100
# Frozen Helius V5 capacity window. Keep exactly 120000 while that experiment is enabled.
FINALIST_ACCOUNT_VERIFIER_TTL_MS=120000
FINALIST_ACCOUNT_VERIFIER_FRESH_MS=1500
FINALIST_ACCOUNT_VERIFIER_INITIAL_SNAPSHOT_ENABLED=true
FINALIST_ACCOUNT_VERIFIER_INITIAL_SNAPSHOT_METHOD=getMultipleAccountsInfo
FINALIST_ACCOUNT_VERIFIER_MIN_SCORE=70
FINALIST_ACCOUNT_VERIFIER_MIN_CURVE_PROGRESS=0.6
FINALIST_ACCOUNT_VERIFIER_MIN_CONFIRMED_SCORE=65
FINALIST_ACCOUNT_VERIFIER_MIN_CONFIRMED_CURVE_PROGRESS=0.5
FINALIST_ACCOUNT_VERIFIER_MIN_WALLET_SCORE=55
FINALIST_ACCOUNT_VERIFIER_MAX_CURVE_DELTA=0.05

# Report-only live execution dry-run. Never broadcasts; blocks until a real Pump tx builder exists.
LIVE_DRY_RUN_ENABLED=false
LIVE_DRY_RUN_AMOUNT_SOL=0.1
LIVE_DRY_RUN_MAX_ACCOUNT_AGE_MS=1500
LIVE_DRY_RUN_MAX_PRICE_IMPACT_PCT=2
LIVE_DRY_RUN_MAX_QUOTE_RESERVE_DRIFT_PCT=10
LIVE_DRY_RUN_MAX_PER_RUN=200
LIVE_DRY_RUN_MINT_COOLDOWN_MS=15000
LIVE_DRY_RUN_SIMULATION_FAILURE_COOLDOWN_MS=300000
LIVE_DRY_RUN_FETCH_BLOCKHASH=true
LIVE_DRY_RUN_REQUIRE_TRANSACTION_BUILDER=true
LIVE_DRY_RUN_PUMP_BUY_V2_BUILDER_ENABLED=true
LIVE_DRY_RUN_SIMULATE_TRANSACTION=false
LIVE_DRY_RUN_SIGN_FOR_SIMULATION=false
LIVE_DRY_RUN_SIMULATION_COMMITMENT=processed
LIVE_DRY_RUN_BUY_SLIPPAGE_BPS=2000
LIVE_DRY_RUN_KEYPAIR_LABEL=hot_wallet

# Report-only event-loop lag monitor for diagnosing delayed timers/child RPC wrappers.
EVENT_LOOP_MONITOR_ENABLED=true
EVENT_LOOP_MONITOR_INTERVAL_MS=1000
EVENT_LOOP_MONITOR_LAG_THRESHOLD_MS=250
RUNTIME_STATUS_INTERVAL_MS=60000
RUNTIME_STATUS_DETAIL_EVERY=5

# Launch-intel snapshots can become large; keep runtime flushes sparse and
# write heavy wallet/deployer indexes less often than the lightweight latest file.
LAUNCH_INTEL_RUNTIME_FLUSH_ENABLED=false
LAUNCH_INTEL_FLUSH_INTERVAL_MS=60000
LAUNCH_INTEL_INDEX_FLUSH_INTERVAL_MS=300000

# Solana RPC HTTP transport. keepalive is the default runtime mode; set mode=false
# for an A/B run with no agent, or default to let @solana/web3.js choose.
SOLANA_RPC_HTTP_AGENT_MODE=keepalive
# Account-read transport for getAccountInfo/getMultipleAccountsInfo only:
# web3, raw-fetch, native-https, or child-https.
# child-https uses a short-lived worker process to isolate reads from runtime event-loop stalls.
SOLANA_RPC_ACCOUNT_READ_TRANSPORT=web3
# Optional override for account-read verification only. Leave blank to use SOLANA_RPC_URL.
SOLANA_RPC_ACCOUNT_READ_URL=
SOLANA_RPC_HTTP_AGENT_KEEPALIVE_MSECS=1000
SOLANA_RPC_HTTP_AGENT_MAX_SOCKETS=16
SOLANA_RPC_HTTP_AGENT_MAX_FREE_SOCKETS=8
SOLANA_RPC_HTTP_AGENT_TIMEOUT_MS=5000
SOLANA_RPC_HTTP_AGENT_SCHEDULING=lifo

# PumpDev targeted on-chain parity is report-only. Default scope keeps Helius
# reads near final paper/live candidates instead of broad watch/skip curiosity.
PUMPDEV_TARGETED_CURVE_PARITY_ENABLED=true
PUMPDEV_TARGETED_CURVE_PARITY_SAMPLE_WATCH_ENABLED=false
PUMPDEV_TARGETED_CURVE_PARITY_SAMPLE_SKIPS_ENABLED=false
PUMPDEV_TARGETED_CURVE_PARITY_SAMPLE_ELIGIBLE_ENABLED=true
PUMPDEV_TARGETED_CURVE_PARITY_MAX_SAMPLES_PER_RUN=25
PUMPDEV_TARGETED_CURVE_PARITY_COOLDOWN_MS=300000
PUMPDEV_TARGETED_CURVE_PARITY_MAX_IN_FLIGHT=1
PUMPDEV_TARGETED_CURVE_PARITY_TIMEOUT_MS=10000
PUMPDEV_TARGETED_CURVE_PARITY_MAX_COMPARABLE_LATENCY_MS=2500
PUMPDEV_TARGETED_CURVE_PARITY_SKIP_LOG_COOLDOWN_MS=10000

# Hybrid feed roles: PumpPortal supplies broad discovery/trade features while
# PumpDev spends its ACK-confirmed capacity on flagged/finalist depth.
PUMPDEV_SHADOW_ENABLED=true
PUMPDEV_FEED_MODE=shadow
# Paste the authenticated websocket URL supplied by PumpDev here when available.
# The current integration reads the credential-bearing URL directly; there is no
# separate PUMPDEV_API_KEY setting.
PUMPDEV_WS_URL=wss://pumpdev.io/ws
PUMPDEV_TRADE_SUBSCRIPTION_MODE=targeted_candidates
PUMPDEV_TARGETED_SUBSCRIPTION_TTL_MS=180000
PUMPPORTAL_BACKUP_ONLY=false

# In PumpDev-primary paper runs, stop early if the websocket opens but delivers
# only system/heartbeat messages. This prevents wasting long sessions when the
# primary discovery feed is silent.
PUMPDEV_PRIMARY_SILENCE_FAIL_FAST=true
PUMPDEV_PRIMARY_SILENCE_TIMEOUT_MS=600000

# Maximum configured PumpDev token-trade subscriptions. Anonymous capacity is
# learned from server ACK/errors; targeted mode spends it on finalists only.
PUMPDEV_MAX_SUBSCRIBED_MINTS=100

# PumpDev rate-limit protection. Reconnects resubscribe recent tracked mints in
# small batches and cool down after websocket 1008 rate-limit closes.
PUMPDEV_RECONNECT_RESUBSCRIBE_MAX_MINTS=25
PUMPDEV_RECONNECT_RESUBSCRIBE_BATCH_SIZE=5
PUMPDEV_RECONNECT_RESUBSCRIBE_BATCH_DELAY_MS=2000
PUMPDEV_RATE_LIMIT_COOLDOWN_MS=60000
PUMPDEV_RECONNECT_DELAY_RESET_AFTER_STABLE_MS=120000
PUMPDEV_PING_INTERVAL_MS=25000
PUMPDEV_RECONNECT_DELAY_MS=5000
PUMPDEV_MAX_RECONNECT_DELAY_MS=30000
PUMPDEV_EVENT_HANDLER_CONCURRENCY=4
PUMPDEV_EVENT_QUEUE_MAX_SIZE=10000
PUMPDEV_TRADE_COALESCE_QUEUE_DEPTH=500
PUMPDEV_PROVIDER_CURVE_VERIFICATION_ENABLED=false

# Moonshot feed scaffold. Disabled until the exact API surface is mapped.
MOONSHOT_ENABLED=false
MOONSHOT_API_BASE_URL=https://api.moonshot.cc

# Passive candidate dossier exports and post-migration continuation observer.
CANDIDATE_DOSSIER_ENABLED=true
CANDIDATE_DOSSIER_INCLUDE_OBSERVED=false
CANDIDATE_DOSSIER_MAX_RECENT=25
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CACHE_TTL_MS=120000
POST_MIGRATION_CONTINUATION_ENABLED=true
POST_MIGRATION_CONTINUATION_MIN_SCORE=65
POST_MIGRATION_CONTINUATION_CONFIRM_MIN_SCORE=75
POST_MIGRATION_CONTINUATION_MIN_LIQUIDITY_USD=25000
POST_MIGRATION_CONTINUATION_MIN_VOLUME_TO_LIQUIDITY=2
POST_MIGRATION_CONTINUATION_MIN_VOLUME_1H_USD=10000
POST_MIGRATION_CONTINUATION_MIN_AGE_HOURS=0.25
POST_MIGRATION_CONTINUATION_MAX_AGE_HOURS=168
POST_MIGRATION_CONTINUATION_MAX_SELL_TXN_RATIO=0.72
POST_MIGRATION_CONTINUATION_FLAG_COOLDOWN_MS=300000
POST_MIGRATION_CONTINUATION_MAX_TRACKED_MINTS=2500
POST_MIGRATION_CONTINUATION_MAX_DEXSCREENER_FETCHES_PER_CYCLE=6
CONTINUATION_PAPER_ENTRY_SLIPPAGE_PCT=0.01
CONTINUATION_PAPER_EXIT_SLIPPAGE_PCT=0.015
CONTINUATION_PAPER_STAGED_EXIT_ENABLED=false
CONTINUATION_PAPER_STAGED_EXIT_FIRST_FRACTION=0.5
CONTINUATION_PAPER_STAGED_EXIT_FIRST_AFTER_MINUTES=3
CONTINUATION_PAPER_STAGED_EXIT_SECOND_FRACTION=0.4
CONTINUATION_PAPER_STAGED_EXIT_SECOND_AFTER_MINUTES=10
CONTINUATION_PAPER_PAUSE_NEW_ENTRIES_IN_CHURN=true

# Pre-migration watch lane. Keeps pre-bonding tape visible without authorizing trades.
PRE_MIGRATION_WATCH_ENABLED=true
PRE_MIGRATION_WATCH_MIN_SCORE=25
PRE_MIGRATION_WATCH_CONFIRM_MIN_SCORE=60
PRE_MIGRATION_WATCH_INTEREST_MIN_TRADE_VELOCITY_PER_MIN=1.5
PRE_MIGRATION_WATCH_INTEREST_MIN_RECENT_VOLUME_SOL=0.15
PRE_MIGRATION_WATCH_INTEREST_MIN_CURVE_PROGRESS=0.45
PRE_MIGRATION_WATCH_INTEREST_MIN_UNIQUE_BUYER_COUNT=4
PRE_MIGRATION_WATCH_CONFIRM_MIN_OBSERVATIONS=2
PRE_MIGRATION_WATCH_CONFIRM_MIN_GAP_MS=30000
PRE_MIGRATION_WATCH_FAST_TRACK_SCORE=75
PRE_MIGRATION_WATCH_REQUIRE_SECONDARY_SIGNAL=true
PRE_MIGRATION_WATCH_STRONG_NO_SECONDARY_SCORE=80
PRE_MIGRATION_WATCH_MIN_CURVE_PROGRESS=0.85
PRE_MIGRATION_WATCH_FLAG_COOLDOWN_MS=60000
PRE_MIGRATION_WATCH_MAX_TRACKED_MINTS=5000
# Report-only throttle for repetitive unchanged watch-state telemetry during trade bursts.
PRE_MIGRATION_OBSERVED_TELEMETRY_MIN_INTERVAL_MS=1000
PRE_MIGRATION_OBSERVED_TELEMETRY_MIN_SCORE_DELTA=1
PRE_MIGRATION_OBSERVED_TELEMETRY_MIN_CURVE_DELTA=0.005

# Paper-only pre-migration lane.
PRE_MIGRATION_PAPER_ENABLED=true
PRE_MIGRATION_PAPER_ONLY=true
PRE_MIGRATION_PAPER_MIN_SCORE=85
PRE_MIGRATION_PAPER_MIN_CURVE_PROGRESS=0.85
PRE_MIGRATION_PAPER_MAX_CURVE_PROGRESS=0.92
PRE_MIGRATION_PAPER_MIN_RECENT_VOLUME_SOL=25
PRE_MIGRATION_PAPER_MIN_TRADE_VELOCITY_PER_MIN=25
PRE_MIGRATION_PAPER_TAKE_PROFIT_PCT=0.35
PRE_MIGRATION_PAPER_STOP_LOSS_PCT=0.15
PRE_MIGRATION_PAPER_MAX_HOLD_SECONDS=300
PRE_MIGRATION_PAPER_AMOUNT_SOL=0.1
PRE_MIGRATION_PAPER_SAME_MINT_REENTRY_COOLDOWN_MS=1800000
PRE_MIGRATION_PAPER_BLOCK_AVOID_WALLET_CONTEXT=true
PRE_MIGRATION_PAPER_HIGH_CURVE_REQUIRE_WALLET_CONTEXT=true
PRE_MIGRATION_PAPER_HIGH_CURVE_REQUIRE_WALLET_CONTEXT_MIN_CURVE_PROGRESS=0.88
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_GUARD_ENABLED=true
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_MIN_CURVE_PROGRESS=0.9
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_BLOCK_POSITIVE_SELL_AFTER_BUY=true
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_BLOCK_LOW_SIGNAL_FIRST_TOUCH=true
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_MAX_SNIPER_WALLET_COUNT=7
PRE_MIGRATION_PAPER_RECHECK_REASONS=NO_PRIOR_CURVE_PROGRESS,CURVE_NOT_ADVANCING
PRE_MIGRATION_PAPER_UNFLAGGED_ENTRY_SHADOW_ENABLED=true
PRE_MIGRATION_PAPER_UNFLAGGED_ENTRY_SHADOW_MIN_SCORE=70
PRE_MIGRATION_PAPER_UNFLAGGED_ENTRY_SHADOW_MIN_CURVE_PROGRESS=0.7
PRE_MIGRATION_PAPER_UNFLAGGED_ENTRY_SHADOW_MIN_RECENT_VOLUME_SOL=12
PRE_MIGRATION_PAPER_UNFLAGGED_ENTRY_SHADOW_MIN_TRADE_VELOCITY_PER_MIN=12
PRE_MIGRATION_CURVE_FALSE_NEGATIVE_SHADOW_REPLAY_MAX_FILES=9
PRE_MIGRATION_PAPER_ENABLED_PRESETS=strictMigration,highConfidenceRunner,earlyAccelerationRunner,highConvictionFirstSight
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_RUNNER_MAX_CURVE_PROGRESS=0.95
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_BLOCK_WEAK_WALLET_FLOW=true
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_BLOCK_AVOID_WALLET_CONTEXT=true
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_WEAK_WALLET_FLOW_MIN_LOW_SIGNAL_TOUCHES=3
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_WEAK_WALLET_FLOW_MIN_LATE_SELL_SOL=1
PRE_MIGRATION_PAPER_HIGH_CONVICTION_FIRST_SIGHT_REQUIRE_WALLET_CONTEXT=true
SHADOW_WALLET_FILE_PATH=data/wallet-watchlists/shadow-untracked-wallets.json
RUNNER_REJECT_RUNTIME_SHADOW_ENABLED=true
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_ENABLED=true
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_SCORE=55
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_CURVE_PROGRESS=0.7
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MAX_CURVE_PROGRESS=0.9
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_RECENT_VOLUME_SOL=0.25
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_TRADE_VELOCITY_PER_MIN=1.5
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_INTEREST_COUNT=3
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_UNIQUE_BUYER_COUNT=3
