# ============================================================
# SPECTRE LOCAL RUNTIME CONFIGURATION
# Helius-only, PAPER-first, sanitized template
# ============================================================
#
# Fill credential-bearing values only in your private .env.
# Keep EXECUTION_MODE=PAPER until live readiness is proven.
# Ordinary tuning defaults live in src/config.js; this file keeps only
# credentials, current provider invariants, and deliberate local overrides.

# ============================================================
# REQUIRED PROVIDER ENDPOINTS / CREDENTIALS
# ============================================================
# Helius HTTPS RPC used for account reads and transaction simulation.
SOLANA_RPC_URL=

# Optional second RPC provider. Leave blank if you do not have one.
SOLANA_RPC_FALLBACK=
SOLANA_RPC_FALLBACK_WEBSOCKET_URL=

# At least one Helius websocket URL is required for Helius Pump.fun intake.
# Reuse the same URL in both fields if your plan exposes one endpoint.
HELIUS_STANDARD_WEBSOCKET_URL=
HELIUS_ENHANCED_WEBSOCKET_URL=

# Helius enhanced-transaction parsing/enrichment key.
HELIUS_PARSE_API_KEY=

# Optional execution/enrichment API keys.
JUPITER_API_KEY=
BIRDEYE_API_KEY=

# Wallet secrets are required only for DRY_RUN/LIVE wallet handling.
# PAPER mode can run with these blank.
HOT_WALLET_PRIVATE_KEY=
COLD_WALLET_ADDRESS=
COLD_WALLET_PRIVATE_KEY=

# ============================================================
# RUNTIME MODE / STORAGE
# ============================================================
EXECUTION_MODE=PAPER
SESSION_DURATION_MINUTES=60
PAPER_STARTING_BALANCE_SOL=5
SPECTRE_ARCHIVE_ROOT=E:\Spectre\archives\Spectre-clean
DISABLE_ENV_PROXY=true

# ============================================================
# HELIUS-ONLY PUMP.FUN RUNTIME
# ============================================================
PUMP_DATA_PROVIDER=helius
HELIUS_PUMPFUN_SHADOW_ENABLED=true
HELIUS_PUMPFUN_SHADOW_COMMITMENT=processed
HELIUS_PUMPFUN_SHADOW_EVENT_QUEUE_MAX_SIZE=20000
HELIUS_PUMPFUN_SHADOW_EVENT_QUEUE_BATCH_SIZE=64
HELIUS_PUMPFUN_RUNTIME_QUEUE_MAX_SIZE=20000
HELIUS_PUMPFUN_DECISION_SHADOW_ENABLED=true
PROVIDER_CURVE_VERIFICATION_ENABLED=true

# Helius owns launch-intel state. Blank paths use data/launch-intel/helius/*.
LAUNCH_INTEL_SOURCE=helius
HELIUS_LAUNCH_INTEL_LATEST_FILE_PATH=
HELIUS_LAUNCH_INTEL_HISTORY_FILE_PATH=
HELIUS_LAUNCH_INTEL_DEPLOYER_INDEX_FILE_PATH=
HELIUS_LAUNCH_INTEL_WALLET_INDEX_FILE_PATH=
LAUNCH_INTEL_RUNTIME_FLUSH_ENABLED=false

# ============================================================
# RPC PACING / CURVE TRUTH / FINALIST VERIFIER
# ============================================================
SOLANA_RPC_MAX_CONCURRENT_REQUESTS=2
SOLANA_RPC_MIN_REQUEST_INTERVAL_MS=150
SOLANA_RPC_CALL_TIMEOUT_MS=10000
SOLANA_RPC_HTTP_AGENT_MODE=false
SOLANA_RPC_ACCOUNT_READ_TRANSPORT=child-https

PUMP_BONDING_CURVE_LANE_ENABLED=true
PUMP_BONDING_CURVE_RUNTIME_RPC_ENABLED=true
PUMP_BONDING_CURVE_RPC_COMMITMENT=processed
PUMP_BONDING_CURVE_REFRESH_INTERVAL_MS=15000
PUMP_BONDING_CURVE_BATCH_FETCH_ENABLED=true
PUMP_BONDING_CURVE_BATCH_FLUSH_MS=150
PUMP_BONDING_CURVE_BATCH_MAX_ACCOUNTS=25

FINALIST_ACCOUNT_VERIFIER_ENABLED=true
FINALIST_ACCOUNT_VERIFIER_COMMITMENT=processed
FINALIST_ACCOUNT_VERIFIER_MAX_SUBSCRIPTIONS=100
# Frozen Helius V7 capacity window. Keep exactly 120000 during V7.
FINALIST_ACCOUNT_VERIFIER_TTL_MS=120000
FINALIST_ACCOUNT_VERIFIER_FRESH_MS=1500
FINALIST_ACCOUNT_VERIFIER_INITIAL_SNAPSHOT_ENABLED=true
FINALIST_ACCOUNT_VERIFIER_INITIAL_SNAPSHOT_METHOD=getMultipleAccountsInfo
FINALIST_ACCOUNT_VERIFIER_MIN_SCORE=55
FINALIST_ACCOUNT_VERIFIER_MIN_CURVE_PROGRESS=0.35
FINALIST_ACCOUNT_VERIFIER_MIN_CONFIRMED_SCORE=55
FINALIST_ACCOUNT_VERIFIER_MIN_CONFIRMED_CURVE_PROGRESS=0.35
FINALIST_ACCOUNT_VERIFIER_MIN_WALLET_SCORE=50
FINALIST_ACCOUNT_VERIFIER_MAX_CURVE_DELTA=0.05

# ============================================================
# FROZEN PAPER / RUNNER-WATCH V7 OVERRIDES
# Do not tune these while runner_watch_helius_pump_family_v7 is collecting.
# ============================================================
MAX_QUOTE_AGE_MS=3000
TOKEN_SIGNAL_COOLDOWN_MS=120000
REJECTION_QUARANTINE_MS=60000
QUOTE_FAILURE_QUARANTINE_MS=600000
ENTRY_WARMUP_MS=90000
MAX_PUMP_TOKEN_AGE_SECONDS=600
PUMP_MOMENTUM_WINDOW_MS=120000
MIN_PUMP_RECENT_TRADES=6
MIN_PUMP_BUY_RATIO=0.58
MAX_PUMP_SELL_RATIO=0.45
MIN_PUMP_RECENT_VOLUME_SOL=1.5
MIN_PUMP_TRADE_VELOCITY_PER_MIN=4
MIN_PUMP_MOMENTUM_SCORE=0.68
PUMP_MOMENTUM_WEIGHT=0.35
BAD_EXIT_COOLDOWN_MS=600000
WEAK_EXIT_COOLDOWN_MS=300000

PAPER_STOP_LOSS_PERCENT=0.012
PAPER_TAKE_PROFIT_PERCENT=0.025
PAPER_TRAILING_ACTIVATION_PERCENT=0.020
PAPER_TRAILING_DRAWDOWN_PERCENT=0.008
PAPER_TRAILING_DISTANCE_PERCENT=0.008
PAPER_MIN_HOLD_SECONDS_FOR_PROFIT=45
PAPER_RUNNER_MODE_ENABLED=true
PAPER_RUNNER_REQUIRE_PUMP_MIGRATION=true
RUNNER_RAYDIUM_SHADOW_ENABLED=true
PAPER_RUNNER_MIN_MIGRATED_LIQUIDITY_USD=0
PAPER_MAX_HOLD_MINUTES=8
PAPER_CLOSE_ON_SESSION_END=true
MAX_OPEN_PAPER_POSITIONS=5
PAPER_BALANCE_REFRESH_INTERVAL_MS=60000

PRE_MIGRATION_WATCH_ENABLED=true
PRE_MIGRATION_PAPER_ENABLED=true
PRE_MIGRATION_PAPER_ONLY=true
PRE_MIGRATION_PAPER_ENABLED_PRESETS=strictMigration,highConfidenceRunner
# Preserve the sanitized private-env values; changing them starts a new V7 era.
PRE_MIGRATION_PAPER_MIN_CURVE_PROGRESS=0.70
PRE_MIGRATION_PAPER_TAKE_PROFIT_PCT=0.50
PRE_MIGRATION_PAPER_PROVE_BY_SECONDS=60
PRE_MIGRATION_PAPER_LOG_DECISION_EVENTS=true
PRE_MIGRATION_PAPER_RECHECK_ENABLED=true
PRE_MIGRATION_PAPER_BLOCK_AVOID_WALLET_CONTEXT=true
PRE_MIGRATION_PAPER_HIGH_CURVE_REQUIRE_WALLET_CONTEXT=true
PRE_MIGRATION_PAPER_HIGH_CURVE_WALLET_QUALITY_GUARD_ENABLED=true
PRE_MIGRATION_PAPER_EARLY_ACCELERATION_BLOCK_WEAK_WALLET_FLOW=true

# ============================================================
# TRADING / RISK / DRY-RUN SAFETY
# ============================================================
TRADING_AMOUNT_SOL=0.1
SLIPPAGE_TOLERANCE=0.5
MAX_PRICE_IMPACT=0.08
MIN_LIQUIDITY_USD=5000
MIN_QUALITY_SCORE=0.42
MAX_TOP10_HOLDER_PERCENT=0.50
MAX_DEV_HOLDING_PERCENT=0.10
REJECT_TOKEN_2022=true

MAX_POSITION_SIZE_SOL=1.0
MAX_OPEN_LIVE_POSITIONS=1
STOP_LOSS_PERCENT=0.10
TAKE_PROFIT_PERCENT=0.20
MAX_DAILY_LOSS_SOL=0.5
LIVE_EXIT_ENGINE_ENABLED=true

LIVE_DRY_RUN_ENABLED=true
LIVE_DRY_RUN_MAX_PER_RUN=200
LIVE_DRY_RUN_SIMULATE_TRANSACTION=true
LIVE_DRY_RUN_SIGN_FOR_SIMULATION=true
LIVE_DRY_RUN_REQUIRE_TRANSACTION_BUILDER=true
LIVE_DRY_RUN_PUMP_BUY_V2_BUILDER_ENABLED=true
LIVE_DRY_RUN_SIMULATION_COMMITMENT=processed

# Future live compounding behavior. Inactive while EXECUTION_MODE=PAPER.
AUTO_PROFIT_TAKING=true
DYNAMIC_THRESHOLD=true
AUTO_REBALANCE_ENABLED=true

# ============================================================
# MARKET ENRICHMENT / WALLET INTELLIGENCE
# ============================================================
METEORA_ENABLED=true
BIRDEYE_ENABLED=true
BIRDEYE_TARGET_RPM=20
BIRDEYE_MAX_TOKENS_PER_CYCLE=1

# Provider-neutral tracked addresses, comma separated.
TRACKED_WALLET_ACCOUNTS=
WALLET_INTEL_ENABLED=true
WALLET_INTEL_FILE_PATH=data/wallet-intel/latest.json
WALLET_INTEL_REFRESH_INTERVAL_MS=60000
SHADOW_WALLET_FILE_PATH=data/wallet-watchlists/shadow-untracked-wallets.json
WALLET_PROMOTION_REVIEW_FILE_PATH=data/reports/wallet-promotion-review-latest.json

# ============================================================
# TELEGRAM / RICK CONTEXT
# ============================================================
TELEGRAM_CONTEXT_ENABLED=true
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_CHAT_NAMES=
TELEGRAM_CONTEXT_FILE_PATH=data/telegram-context/latest.json
TELEGRAM_STATE_FILE_PATH=data/telegram-context/state.json
TELEGRAM_STRING_SESSION_FILE_PATH=data/telegram-context/string-session.txt
TELEGRAM_CONTEXT_REFRESH_INTERVAL_MS=60000
TELEGRAM_CONTEXT_WINDOW_HOURS=24
TELEGRAM_MAX_MESSAGES_PER_CHAT=200
TELEGRAM_MAX_STORED_MESSAGES=2000

RICK_CONTEXT_ENABLED=true
RICK_CONTEXT_FILE_PATH=data/rick-context/latest.json
RICK_CONTEXT_REFRESH_INTERVAL_MS=60000
RICK_CONTEXT_SOURCE_CHAT_NAMES=
RICK_COMMAND_TARGET_CHAT_NAME=
RICK_COMMAND_STATE_FILE_PATH=data/rick-context/command-state.json
RICK_COMMAND_COOLDOWN_HOURS=4

# ============================================================
# LOCAL AI AUDITOR
# ============================================================
AI_MODEL=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
SIMPLE_RUNTIME_AI_ENABLED=true
SIMPLE_RUNTIME_AI_MODEL=qwen2.5:7b-instruct
SIMPLE_RUNTIME_AI_TIMEOUT_MS=3000
SIMPLE_RUNTIME_AI_NUM_PREDICT=80
SIMPLE_RUNTIME_AI_WARMUP_TIMEOUT_MS=90000
AI_FALLBACK_MODEL=qwen3.5:4b
AI_TIMEOUT_MS=3000
AI_WARMUP_TIMEOUT_MS=30000
OLLAMA_KEEP_ALIVE=2h
AI_TIMEOUT_DEFAULTS_TO_VETO=true
AI_REQUIRED_FOR_TRADE=false
AI_TIMEOUT_FALLBACK_ENABLED=true
AI_TIMEOUT_FALLBACK_PAPER_ONLY=true
AI_TIMEOUT_FALLBACK_MIN_QUALITY_SCORE=0.48
AI_TIMEOUT_FALLBACK_MIN_MOMENTUM_SCORE=0.78
USE_LOCAL_MODEL=true
COST_OPTIMIZATION=true

# ============================================================
# TELEMETRY / REPORTING / RUNTIME HEALTH
# ============================================================
TELEMETRY_ENABLED=true
TELEMETRY_LOG_DIR=run-logs
TELEMETRY_MAX_RECENT_EVENTS=5000
LOG_LEVEL=info
RUNTIME_DECISION_LOGS_ENABLED=false
POST_RUN_NODE_OPTIONS=--max-old-space-size=8192
POST_RUN_SKIP_REPORTS=wallet-historical-run-retrospective-report.js,wallet-timeblocked-stability-report.js

EVENT_LOOP_MONITOR_ENABLED=true
EVENT_LOOP_MONITOR_INTERVAL_MS=1000
EVENT_LOOP_MONITOR_LAG_THRESHOLD_MS=250
RUNTIME_STATUS_INTERVAL_MS=60000
RUNTIME_STATUS_DETAIL_EVERY=5

PRIORITY_FEE=1000
MAX_CONCURRENT_TRANSACTIONS=3
TRANSACTION_TIMEOUT_MS=30000
DEBUG_MODE=false
