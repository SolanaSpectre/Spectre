PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MAX_CURVE_SNAPSHOT_AGE_SECONDS=30
PRE_MIGRATION_PAPER_HIGH_CURVE_STALE_SNAPSHOT_GUARD_ENABLED=true
PRE_MIGRATION_PAPER_HIGH_CURVE_STALE_SNAPSHOT_MIN_CURVE_PROGRESS=0.9
PRE_MIGRATION_PAPER_HIGH_CURVE_STALE_SNAPSHOT_MAX_CURVE_SNAPSHOT_AGE_SECONDS=30
PRE_MIGRATION_PAPER_LOG_DECISION_EVENTS=true
PRE_MIGRATION_PAPER_RECHECK_ENABLED=true
PRE_MIGRATION_PAPER_RECHECK_DELAY_MS=10000
PRE_MIGRATION_PAPER_RECHECK_MAX_ATTEMPTS=2
PRE_MIGRATION_PAPER_RECHECK_MAX_AGE_MS=1800000
PRE_MIGRATION_PAPER_RECHECK_MAX_TRACKED_MINTS=500

