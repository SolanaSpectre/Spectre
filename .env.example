# ==========================================
MIN_LIQUIDITY_USD=5000
MIN_QUALITY_SCORE=0.42
MAX_TOP10_HOLDER_PERCENT=0.50
MAX_DEV_HOLDING_PERCENT=0.10
REJECT_TOKEN_2022=true

