# ==========================================
REFRESH_INTERVAL_MS=5000
VOLUME_THRESHOLD_SOL=100
LIQUIDITY_THRESHOLD_SOL=50
MAX_SIGNALS_PER_CYCLE=2
EXCLUDED_TOKEN_SYMBOLS=USDC,USDT,USD1,WSOL,SOL
EXCLUDED_TOKEN_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB,USD1ttGY1N17NEEHLmELoaybftRBUSErhqYiQzvEmuB
