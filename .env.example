# ==========================================
# SOLANA MEMECOIN TRADING BOT CONFIGURATION
# ==========================================

# ==========================================
# SOLANA RPC CONFIGURATION
# ==========================================
# Primary RPC URL. Use your Helius secure RPC here.
SOLANA_RPC_URL=

# Optional primary websocket URL for the Solana RPC above.
SOLANA_RPC_WEBSOCKET_URL=

# Fallback RPC URL. Use your Helius fallback RPC here.
SOLANA_RPC_FALLBACK=

# Optional websocket URL for the fallback RPC above.
SOLANA_RPC_FALLBACK_WEBSOCKET_URL=

# How long to prefer fallback after a primary RPC failure.
SOLANA_RPC_PRIMARY_DOWNGRADE_MS=300000

# Optional Helius aliases if you want to keep the raw websocket URLs separate.
HELIUS_ENHANCED_WEBSOCKET_URL=
HELIUS_STANDARD_WEBSOCKET_URL=

# Helius Parse API Key for enhanced transaction parsing/enrichment.
HELIUS_PARSE_API_KEY=

# ==========================================
# WALLET CONFIGURATION
# ==========================================
# Hot Wallet Private Key for active trading.
HOT_WALLET_PRIVATE_KEY=

# Cold Wallet Address for profit storage.
COLD_WALLET_ADDRESS=

# Cold Wallet Private Key is optional. Leave blank unless intentionally used later.
COLD_WALLET_PRIVATE_KEY=

# ==========================================
# EXECUTION / SESSION CONFIGURATION
# ==========================================
# Execution mode: DRY_RUN, PAPER, or LIVE.
EXECUTION_MODE=PAPER

# Paper/session runtime in minutes. CLI flags can override this.
SESSION_DURATION_MINUTES=15

# Virtual starting balance for PAPER mode.
PAPER_STARTING_BALANCE_SOL=5

# Require LIVE mode to be explicitly confirmed via CLI.
MAX_QUOTE_AGE_MS=3000
TOKEN_SIGNAL_COOLDOWN_MS=120000
REJECTION_QUARANTINE_MS=60000
QUOTE_FAILURE_QUARANTINE_MS=600000
ENTRY_WARMUP_MS=90000
MAX_PUMP_TOKEN_AGE_SECONDS=300
PUMP_MOMENTUM_WINDOW_MS=120000
MIN_PUMP_RECENT_TRADES=6
MIN_PUMP_BUY_RATIO=0.62
MAX_PUMP_SELL_RATIO=0.32
MIN_PUMP_RECENT_VOLUME_SOL=1.5
MIN_PUMP_TRADE_VELOCITY_PER_MIN=4
MIN_PUMP_MOMENTUM_SCORE=0.68
PUMP_MOMENTUM_WEIGHT=0.35
BAD_EXIT_COOLDOWN_MS=600000
WEAK_EXIT_COOLDOWN_MS=300000
PAPER_STOP_LOSS_PERCENT=0.012
PAPER_TAKE_PROFIT_PERCENT=0.025
PAPER_TRAILING_ACTIVATION_PERCENT=0.020
PAPER_TRAILING_DRAWDOWN_PERCENT=0.008
PAPER_TRAILING_DISTANCE_PERCENT=0.008
PAPER_MIN_HOLD_SECONDS_FOR_PROFIT=45
PAPER_RUNNER_MODE_ENABLED=true
PAPER_RUNNER_REQUIRE_PUMP_MIGRATION=true
RUNNER_RAYDIUM_SHADOW_ENABLED=true
PAPER_RUNNER_MIN_MIGRATED_LIQUIDITY_USD=0
PAPER_MAX_HOLD_MINUTES=8
PAPER_CLOSE_ON_SESSION_END=true
MAX_OPEN_PAPER_POSITIONS=5
# PAPER mode only: cache hot/cold balance reads for status accounting.
PAPER_BALANCE_REFRESH_INTERVAL_MS=60000
LIVE_EXIT_ENGINE_ENABLED=true

# ==========================================
# PROVIDER / MARKET DATA CONFIGURATION
# ==========================================
# Disable inherited Windows proxy env vars for API clients.
DISABLE_ENV_PROXY=true

# Jupiter quote/order/execute API.
JUPITER_API_BASE_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# Raydium v3 pool API.
RAYDIUM_API_BASE_URL=https://api-v3.raydium.io
# Cache global pool list snapshots to avoid hammering Raydium during provider trouble.
RAYDIUM_POOL_CACHE_TTL_MS=60000
RAYDIUM_POOL_STALE_TTL_MS=300000

# Meteora DLMM pool API.
METEORA_ENABLED=true
METEORA_API_BASE_URL=https://dlmm.datapi.meteora.ag
# Cache global pool list snapshots to avoid hammering Meteora during provider trouble.
METEORA_POOL_CACHE_TTL_MS=60000
METEORA_POOL_STALE_TTL_MS=300000

# Birdeye enrichment. Keep enabled; it only activates when a key is present.
BIRDEYE_ENABLED=true
BIRDEYE_API_KEY=
BIRDEYE_API_BASE_URL=https://public-api.birdeye.so
# Standard Birdeye package is capped at 60 rpm total; keep the bot under that.
BIRDEYE_RATE_LIMIT_RPM=60
BIRDEYE_TARGET_RPM=45
BIRDEYE_CACHE_TTL_MS=60000
BIRDEYE_ERROR_CACHE_TTL_MS=15000
BIRDEYE_MAX_TOKENS_PER_CYCLE=1
BIRDEYE_RETRY_BASE_DELAY_MS=1000
BIRDEYE_MAX_RETRIES=3
BIRDEYE_SECURITY_ENABLED=false
BIRDEYE_HOLDER_DISTRIBUTION_ENABLED=false

# PumpPortal websocket/data API.
PUMPPORTAL_ENABLED=true
PUMP_PORTAL_API_KEY=
PUMPPORTAL_USE_API_KEY_QUERY=true
PUMPPORTAL_WEBSOCKET_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_TRACKED_ACCOUNTS=
PUMPPORTAL_RECONNECT_DELAY_MS=5000
PUMPPORTAL_MAX_RECONNECT_DELAY_MS=60000
PUMPPORTAL_STALE_CONNECTION_MS=90000
PUMPPORTAL_HEALTH_CHECK_INTERVAL_MS=15000

# Pump bonding curve RPC enrichment. Failure cooldown prevents repeated getAccountInfo
# retries for the same mint; global backoff pauses fresh lookups during RPC trouble.
PUMP_BONDING_CURVE_FAILURE_COOLDOWN_MS=120000
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_MS=30000
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_ERROR_THRESHOLD=5
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_WINDOW_MS=15000
# During global RPC backoff, already-observed high-curve mints can still refresh
# so near-migration candidates do not go stale behind low-curve lookup noise.
PUMP_BONDING_CURVE_GLOBAL_BACKOFF_HIGH_CURVE_BYPASS_PROGRESS=0.85

# Moonshot feed scaffold. Disabled until the exact API surface is mapped.
MOONSHOT_ENABLED=false
MOONSHOT_API_BASE_URL=https://api.moonshot.cc

# Passive candidate dossier exports and post-migration continuation observer.
CANDIDATE_DOSSIER_ENABLED=true
CANDIDATE_DOSSIER_INCLUDE_OBSERVED=false
CANDIDATE_DOSSIER_MAX_RECENT=25
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CACHE_TTL_MS=120000
POST_MIGRATION_CONTINUATION_ENABLED=true
POST_MIGRATION_CONTINUATION_MIN_SCORE=65
POST_MIGRATION_CONTINUATION_CONFIRM_MIN_SCORE=75
POST_MIGRATION_CONTINUATION_MIN_LIQUIDITY_USD=25000
POST_MIGRATION_CONTINUATION_MIN_VOLUME_TO_LIQUIDITY=2
POST_MIGRATION_CONTINUATION_MIN_VOLUME_1H_USD=10000
POST_MIGRATION_CONTINUATION_MIN_AGE_HOURS=0.25
POST_MIGRATION_CONTINUATION_MAX_AGE_HOURS=168
POST_MIGRATION_CONTINUATION_MAX_SELL_TXN_RATIO=0.72
POST_MIGRATION_CONTINUATION_FLAG_COOLDOWN_MS=300000
POST_MIGRATION_CONTINUATION_MAX_TRACKED_MINTS=2500
POST_MIGRATION_CONTINUATION_MAX_DEXSCREENER_FETCHES_PER_CYCLE=6
CONTINUATION_PAPER_ENTRY_SLIPPAGE_PCT=0.01
CONTINUATION_PAPER_EXIT_SLIPPAGE_PCT=0.015
CONTINUATION_PAPER_STAGED_EXIT_ENABLED=false
CONTINUATION_PAPER_STAGED_EXIT_FIRST_FRACTION=0.5
CONTINUATION_PAPER_STAGED_EXIT_FIRST_AFTER_MINUTES=3
CONTINUATION_PAPER_STAGED_EXIT_SECOND_FRACTION=0.4
CONTINUATION_PAPER_STAGED_EXIT_SECOND_AFTER_MINUTES=10

# Pre-migration watch lane. Keeps pre-bonding tape visible without authorizing trades.
PRE_MIGRATION_WATCH_ENABLED=true
PRE_MIGRATION_WATCH_MIN_SCORE=25
PRE_MIGRATION_WATCH_CONFIRM_MIN_SCORE=60
PRE_MIGRATION_WATCH_INTEREST_MIN_TRADE_VELOCITY_PER_MIN=1.5
PRE_MIGRATION_WATCH_INTEREST_MIN_RECENT_VOLUME_SOL=0.15
PRE_MIGRATION_WATCH_INTEREST_MIN_CURVE_PROGRESS=0.45
PRE_MIGRATION_WATCH_INTEREST_MIN_UNIQUE_BUYER_COUNT=4
PRE_MIGRATION_WATCH_CONFIRM_MIN_OBSERVATIONS=2
PRE_MIGRATION_WATCH_CONFIRM_MIN_GAP_MS=30000
PRE_MIGRATION_WATCH_FAST_TRACK_SCORE=75
PRE_MIGRATION_WATCH_REQUIRE_SECONDARY_SIGNAL=true
PRE_MIGRATION_WATCH_STRONG_NO_SECONDARY_SCORE=80
PRE_MIGRATION_WATCH_MIN_CURVE_PROGRESS=0.85
PRE_MIGRATION_WATCH_FLAG_COOLDOWN_MS=60000
PRE_MIGRATION_WATCH_MAX_TRACKED_MINTS=5000

# Paper-only pre-migration lane.
PRE_MIGRATION_PAPER_ENABLED=true
PRE_MIGRATION_PAPER_ONLY=true
PRE_MIGRATION_PAPER_MIN_SCORE=85
PRE_MIGRATION_PAPER_MIN_CURVE_PROGRESS=0.85
PRE_MIGRATION_PAPER_MAX_CURVE_PROGRESS=0.92
PRE_MIGRATION_PAPER_MIN_RECENT_VOLUME_SOL=25
PRE_MIGRATION_PAPER_MIN_TRADE_VELOCITY_PER_MIN=25
PRE_MIGRATION_PAPER_TAKE_PROFIT_PCT=0.35
PRE_MIGRATION_PAPER_STOP_LOSS_PCT=0.15
PRE_MIGRATION_PAPER_MAX_HOLD_SECONDS=300
PRE_MIGRATION_PAPER_AMOUNT_SOL=0.1
PRE_MIGRATION_PAPER_ENABLED_PRESETS=strictMigration,highConfidenceRunner,earlyAccelerationRunner,highConvictionFirstSight
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_ENABLED=true
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_SCORE=55
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_CURVE_PROGRESS=0.7
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MAX_CURVE_PROGRESS=0.9
PRE_MIGRATION_PAPER_FIRST_CURVE_SNAPSHOT_SCALP_MIN_RECENT_VOLUME_SOL=0.25
